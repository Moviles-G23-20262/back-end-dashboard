generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  fullName        String
  major           String
  faculty         String?
  rating          Float      @default(0)
  createdAt       DateTime   @default(now())
  buyerChatRooms  ChatRoom[] @relation("ChatRoomBuyer")
  sellerChatRooms ChatRoom[] @relation("ChatRoomSeller")
  materials       Material[]
  sentMessages    Message[]

  buyerExchanges  Exchange[] @relation("ExchangeBuyer")
  sellerExchanges Exchange[] @relation("ExchangeSeller")

  wishlistItems   WishlistItem[]
  notifications   Notification[]
  analyticsEvents AnalyticsEvent[]

  ratingsGiven    Rating[] @relation("RatingRater")
  ratingsReceived Rating[] @relation("RatingRated")

  meetingProposals MeetingProposal[]
  scheduleBlocks   ScheduleBlock[]
}

model Material {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  description String
  courseCode  String?
  price       Decimal            @db.Decimal(10, 2)
  condition   MaterialCondition?
  status      MaterialStatus     @default(AVAILABLE)
  edition     String?
  model       String?
  imageUrls   String[]
  sellerId    String             @db.Uuid
  chatRooms   ChatRoom[]
  seller      User               @relation(fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category        MaterialCategory
  exchanges       Exchange[]
  wishlistItems   WishlistItem[]
  notifications   Notification[]
  analyticsEvents AnalyticsEvent[]

  @@index([courseCode])
  @@index([status])
  @@index([sellerId])
}

model ChatRoom {
  id         String    @id @default(uuid()) @db.Uuid
  materialId String    @db.Uuid
  buyerId    String    @db.Uuid
  sellerId   String    @db.Uuid
  createdAt  DateTime  @default(now())
  buyer      User      @relation("ChatRoomBuyer", fields: [buyerId], references: [id])
  material   Material  @relation(fields: [materialId], references: [id])
  seller     User      @relation("ChatRoomSeller", fields: [sellerId], references: [id])
  messages   Message[]

  meetingProposals MeetingProposal[]

  @@index([materialId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id         String      @id @default(uuid()) @db.Uuid
  chatRoomId String      @db.Uuid
  senderId   String      @db.Uuid
  content    String
  type       MessageType @default(TEXT)
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  chatRoom   ChatRoom    @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id])

  // Set when `type` is MEETING: the chat shows the proposal as a card.
  meetingProposalId String?          @db.Uuid
  meetingProposal   MeetingProposal? @relation(fields: [meetingProposalId], references: [id], onDelete: SetNull)

  @@index([chatRoomId, createdAt])
  @@index([senderId])
}

// An order: placed by the buyer (PENDING), then COMPLETED after they meet, or CANCELLED.
model Exchange {
  id          String         @id @default(uuid()) @db.Uuid
  orderNumber Int            @unique @default(autoincrement())
  materialId  String         @db.Uuid
  buyerId     String         @db.Uuid
  sellerId    String         @db.Uuid
  price       Decimal        @db.Decimal(10, 2)
  status      ExchangeStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  cancelledAt DateTime?

  // What the buyer says they received, checked at the meetup.
  receivedCondition MaterialCondition?

  meetingPointId  String?   @db.Uuid
  meetingStartsAt DateTime?
  meetingEndsAt   DateTime?
  lat             Float?
  lng             Float?

  material     Material      @relation(fields: [materialId], references: [id])
  buyer        User          @relation("ExchangeBuyer", fields: [buyerId], references: [id])
  seller       User          @relation("ExchangeSeller", fields: [sellerId], references: [id])
  meetingPoint MeetingPoint? @relation(fields: [meetingPointId], references: [id], onDelete: SetNull)

  ratings Rating[]

  @@index([materialId])
  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([completedAt])
  @@index([meetingPointId])
}

model MeetingPoint {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  detail      String?
  zoneType    MeetingZoneType
  isMonitored Boolean         @default(false)
  lat         Float
  lng         Float
  createdAt   DateTime        @default(now())

  exchanges        Exchange[]
  meetingProposals MeetingProposal[]
}

// A time and safe zone one side of a chat proposes; the other side accepts or declines it.
model MeetingProposal {
  id             String                @id @default(uuid()) @db.Uuid
  chatRoomId     String                @db.Uuid
  proposerId     String                @db.Uuid
  meetingPointId String                @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  status         MeetingProposalStatus @default(PENDING)
  respondedAt    DateTime?
  createdAt      DateTime              @default(now())

  chatRoom     ChatRoom     @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  proposer     User         @relation(fields: [proposerId], references: [id])
  meetingPoint MeetingPoint @relation(fields: [meetingPointId], references: [id])
  messages     Message[]

  @@index([chatRoomId, createdAt])
  @@index([meetingPointId])
}

// One recurring class in a user's week, in campus local time (America/Bogota).
model ScheduleBlock {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  dayOfWeek   Int // 1 = Monday … 7 = Sunday
  startMinute Int // minutes after midnight
  endMinute   Int
  label       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  materialId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  materialId String?          @db.Uuid
  type       NotificationType
  sentAt     DateTime         @default(now())
  openedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([materialId])
  @@index([type])
  @@index([sentAt])
}

model AnalyticsEvent {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String?            @db.Uuid
  materialId String?            @db.Uuid
  eventType  AnalyticsEventType
  metadata   Json?
  occurredAt DateTime           @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([materialId])
  @@index([eventType])
  @@index([occurredAt])
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  exchangeId String   @db.Uuid
  raterId    String   @db.Uuid
  ratedId    String   @db.Uuid
  stars      Int
  tags       String[]
  review     String?
  createdAt  DateTime @default(now())

  exchange Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  rater    User     @relation("RatingRater", fields: [raterId], references: [id])
  rated    User     @relation("RatingRated", fields: [ratedId], references: [id])

  @@unique([exchangeId, raterId])
  @@index([ratedId])
}

enum MaterialCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum MaterialStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum MaterialCategory {
  BOOKS
  CALCULATORS
  LAB_EQUIPMENT
  FURNITURE
  OTHER
}

enum ExchangeStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  MEETING
}

enum MeetingProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MeetingZoneType {
  LIBRARY
  STUDENT_CENTER
  BUILDING_LOBBY
  PLAZA
}

enum NotificationType {
  SMART_MATCH
  ORDER_PLACED
  OTHER
}

enum AnalyticsEventType {
  LISTING_VIEW
  SEARCH
  CONTACT_SELLER
  WISHLIST_ADD
  WISHLIST_REMOVE
  NOTIFICATION_SENT
  NOTIFICATION_OPENED
  SMART_MATCH_SHOWN
  SMART_MATCH_OPENED
  SMART_MATCH_RESERVED
  EXCHANGE_CONFIRMED
}
